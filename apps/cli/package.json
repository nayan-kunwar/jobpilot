{
  "name": "@apps/cli",
  "version": "1.0.0",
  "description": "Send personalized job-application emails with PDF resume via the Gmail API",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "gmail-bulk-sender": "./bin/send.ts" },
  "scripts": {
    "dry": "tsx ./bin/send.ts --dry-run",
    "live": "tsx ./bin/send.ts",
    "send": "tsx ./bin/send.ts",
    "auth": "tsx ./src/auth.ts",
    "setup": "tsx ./scripts/setup.ts",
    "dev": "tsx ./src/index.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.lib.json",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "commander": "^14.0.0",
    "googleapis": "^144.0.0"
  }
}
